# syntax=docker/dockerfile:1.7
# Local-development image for the dashboard: runs the Next.js dev server
# (Webpack, hot module reload) against a bind-mounted source tree instead
# of the compiled standalone build in Dockerfile. Not used in production.

FROM oven/bun:1.3.14-alpine AS bun-runtime

# Use the same real Node runtime as production. Bun's Node fallback can stall
# Turbopack/PostCSS workers on Alpine even after Next reports that it is ready.
FROM node:22.18.0-alpine3.22 AS development

COPY --from=bun-runtime /usr/local/bin/bun /usr/local/bin/bun

WORKDIR /app

COPY package.json bun.lock ./
RUN bun install --frozen-lockfile

COPY . .

ENV NODE_ENV=development
ENV NEXT_TELEMETRY_DISABLED=1
ENV PORT=3000
ENV HOSTNAME=0.0.0.0

RUN mkdir -p /app/.next && chown -R node:node /app
USER node

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=90s --retries=6 \
  CMD ["node", "scripts/dev-healthcheck.mjs"]

CMD ["npm", "run", "dev:docker"]
